# Analysis settings
# -------------------------
PHI_LABELS = {"phi1": "φ = 0", "phi2": "φ = π/4", "phi3": "φ = π/2",
              "phi4": "φ = 3π/4", "phi5": "φ = π"}

FREQS = np.linspace(7, 90, 120)
N_CYCLES = np.minimum(np.maximum(FREQS/2, 3), 15)
 
VMAX = 7.0
VMIN = -7.0
DISPLAY_TMIN = -0.5
DISPLAY_TMAX = 2.0
EPOCH_MIN = -2.0
EPOCH_MAX = 3.5
BASELINE_TMIN = -0.5
BASELINE_TMAX = 0
 
COMPARE_CHANNELS = ['Oz', 'Cz']
CH_LABEL = {'Oz': 'Visual', 'Cz': 'Auditory'}

ROWS_PER_IMAGE = 6

def plot_subject_tfr(ch, fig_title, out_path, subj_subset, part_idx):
    n_rows = len(subj_subset)
    n_cols = len(conds)
    fig, axes = plt.subplots(n_rows, n_cols,
                             figsize=(3.2 * n_cols, 2.4 * n_rows),
                             sharex=True, sharey=True, squeeze=False)
    im = None
    for r, sid in enumerate(subj_subset):
        for c, cond in enumerate(conds):
            ax = axes[r][c]
            data = subj_per_phi.get(sid, {}).get(ch, {}).get(cond, None)
            if data is None:
                ax.axis('off'); continue
            im = _imshow(ax, data)
            if r == 0:
                ax.set_title(PHI_LABELS[cond], fontsize=16)
            if c == 0:
                ax.set_ylabel(f"{sid}\nFreq (Hz)", fontsize=14)
            if r == n_rows - 1:
                ax.set_xlabel("Time (s)", fontsize=14)
    if im is not None:
        fig.subplots_adjust(right=0.91, top=0.96)
        cbar_ax = fig.add_axes([0.93, 0.25, 0.010, 0.5])
        fig.colorbar(im, cax=cbar_ax, label='Power (dB re. baseline)')
    fig.suptitle(f"{fig_title} (part {part_idx})", fontsize=16, y=0.995)
    fig.savefig(out_path, dpi=150)
    plt.show()

def _imshow(ax, data):
    im = ax.imshow(
        data, aspect='auto', origin='lower',
        extent=[times_ref[0], times_ref[-1], FREQS[0], FREQS[-1]],
        vmin=VMIN, vmax=VMAX, cmap='RdBu_r', interpolation='bilinear',
    )
    ax.axvline(0, color='black', lw=1.0, ls='--')
